{
  "version": 2,
  "name": "mypoupar-tv",
  "functions": {
    "api/chat.js":   { "maxDuration": 30, "memory": 256 },
    "api/proxy.js":  { "maxDuration": 30, "memory": 512 },
    "api/verify.js": { "maxDuration": 10, "memory": 128 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
